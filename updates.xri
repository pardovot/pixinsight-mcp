<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>
         PixInsight MCP Watcher - installs the non-blocking native module
         (MCPWatcher-pxm) that lets AI assistants drive PixInsight via the
         @pardovot/pixinsight-mcp MCP server. https://github.com/pardovot/pixinsight-mcp
      </p>
   </description>
   <metadata id="20260810-mcpwatcher-module" releaseDate="20260810">
      <title>
         PixInsight MCP Watcher Module 1.3.5
      </title>
      <description>
         <p>
            Non-blocking bridge module: a pcl::Timer on PixInsight's event loop
            polls ~/.pixinsight-mcp/bridge for commands from the MCP server and
            runs them while PixInsight stays fully interactive. Open it under
            Process &gt; Utilities &gt; MCP Watcher.
         </p>
      </description>
   </metadata>
   <platform os="windows" arch="x64" version="1.9.4:1.9.99">
      <package fileName="mcpwatcher-module-windows.zip" sha1="c488e161d4251af3e3bf1557ef7dd3f7b1bfc575" type="module" metadata="20260810-mcpwatcher-module"/>
   </platform>
   <platform os="linux" arch="x64" version="1.9.4:1.9.99">
      <package fileName="mcpwatcher-module-linux.zip" sha1="0f231a72ab804e35cacde156ab7fc308e80ed5b6" type="module" metadata="20260810-mcpwatcher-module"/>
   </platform>
   <platform os="macosx" arch="all" version="1.9.4:1.9.99">
      <package fileName="mcpwatcher-module-macosx.zip" sha1="416394356f3e664acbda10875b8db16782ec5a31" type="module" metadata="20260810-mcpwatcher-module"/>
   </platform>
</xri>
