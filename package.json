{
  "name": "@pardovot/pixinsight-mcp",
  "version": "1.0.0",
  "description": "MCP server that lets an AI assistant drive PixInsight for astrophotography processing",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pixinsight-mcp": "build/index.js"
  },
  "files": [
    "build/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "author": "pardovot",
  "homepage": "https://github.com/pardovot/pixinsight-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pardovot/pixinsight-mcp.git"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && node scripts/build-pjsr-bundle.mjs && node scripts/check-handler-drift.mjs",
    "test": "npm run lint && npm run build && node --test \"test/*.test.mjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "ping": "node scripts/ping.mjs",
    "smoke:scripts": "node scripts/smoke-scripts.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "pixinsight",
    "mcp",
    "astrophotography",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2"
  }
}
